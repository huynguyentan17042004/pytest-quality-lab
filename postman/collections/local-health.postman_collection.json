{
  "info": {"name": "Local health verification", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "item": [{
    "name": "GET local health",
    "request": {"method": "GET", "url": "{{baseUrl}}/health"},
    "event": [{"listen": "test", "script": {"exec": ["pm.test('status is 200', () => pm.response.to.have.status(200));"]}}]
  }]
}
